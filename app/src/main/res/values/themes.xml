<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GMIProspect" parent="Theme.MaterialComponents.Light.NoActionBar.Bridge">
        <item name="colorPrimary">@color/gmi_blue</item>
        <item name="colorAccent">@color/gmi_red</item>
        <item name="android:windowBackground">@color/navy</item>
        <item name="android:statusBarColor">@color/navy</item>
        <item name="android:fontFamily">@font/press_start_2p</item>
        <item name="fontFamily">@font/press_start_2p</item>
    </style>

    <!-- Normal text inside cards -->
    <style name="CardText">
        <item name="android:fontFamily">@font/press_start_2p</item>
        <item name="android:textSize">9sp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:lineSpacingExtra">6dp</item>
    </style>

    <!-- Small yellow labels on the navy background -->
    <style name="LabelText" parent="CardText">
        <item name="android:textColor">@color/yellow</item>
    </style>

    <!-- All buttons -->
    <style name="PixelButton">
        <item name="android:fontFamily">@font/press_start_2p</item>
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:padding">12dp</item>
        <item name="android:background">@drawable/btn_blue</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>