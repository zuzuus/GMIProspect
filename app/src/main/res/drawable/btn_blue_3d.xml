<?xml version="1.0" encoding="utf-8"?>
<!-- 3D pixel button: hard shadow at the bottom-right.
     When pressed, the button moves down into its shadow like an arcade button. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Pressed -->
    <item android:state_pressed="true">
        <layer-list>
            <item android:left="5dp" android:top="5dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/gmi_blue" />
                    <stroke android:width="3dp" android:color="@color/black" />
                </shape>
            </item>
        </layer-list>
    </item>

    <!-- Normal -->
    <item>
        <layer-list>
            <item android:left="5dp" android:top="5dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/shadow" />
                </shape>
            </item>
            <item android:right="5dp" android:bottom="5dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/gmi_blue" />
                    <stroke android:width="3dp" android:color="@color/black" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>