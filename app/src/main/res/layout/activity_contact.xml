<?xml version="1.0" encoding="utf-8"?>
<!-- <layout> tag turns on data binding for this screen -->
<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/navy"
        android:orientation="vertical">

        <!-- Top bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/gmi_red"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp">

            <Button
                android:id="@+id/btnBack"
                style="@style/PixelButton"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:background="@drawable/btn_yellow"
                android:padding="0dp"
                android:text="&lt;"
                android:textColor="@color/black" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:text="CONTACT &amp; ABOUT"
                android:textColor="@color/white"
                android:textSize="13sp" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- ABOUT US section -->
                <TextView
                    style="@style/LabelText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ABOUT US" />

                <TextView
                    style="@style/CardText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/box_card"
                    android:padding="14dp"
                    android:text="@string/about_text" />

                <!-- CONTACT US section -->
                <TextView
                    style="@style/LabelText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="CONTACT US" />

                <TextView style="@style/CardText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/box_card" android:padding="14dp" android:text="@string/gmi_address" />

                <TextView style="@style/CardText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/box_card" android:padding="14dp" android:text="@string/gmi_phone" />

                <TextView style="@style/CardText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/box_card" android:padding="14dp" android:text="@string/gmi_email" />

                <TextView style="@style/CardText" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/box_card" android:padding="14dp" android:text="@string/gmi_website" />

                <Button
                    android:id="@+id/btnCall"
                    style="@style/PixelButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/btn_green"
                    android:text="Call GMI"
                    android:textColor="@color/black" />

                <Button
                    android:id="@+id/btnEmail"
                    style="@style/PixelButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/btn_red"
                    android:text="Send Email" />

                <Button
                    android:id="@+id/btnMap"
                    style="@style/PixelButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Open Map" />

                <Button
                    android:id="@+id/btnWebsite"
                    style="@style/PixelButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Visit Website" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</layout>